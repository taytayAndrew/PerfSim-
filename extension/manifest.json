{
  "manifest_version": 3,
  "name": "PerfSim",
  "version": "0.1.0",
  "description": "Frontend performance simulation — detect serial chains and preview optimizations.",
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-script.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "tabs", "cookies", "alarms", "storage"],
  "host_permissions": ["http://localhost:3000/*", "<all_urls>"],
  "action": {
    "default_popup": "index.html",
    "default_title": "PerfSim"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
